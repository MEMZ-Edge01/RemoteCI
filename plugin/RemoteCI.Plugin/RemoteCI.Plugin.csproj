<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RemoteCI.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RemoteCI.Plugin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 运行时由 ClassIsland 宿主提供，插件包内不携带，避免版本冲突 -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <!-- Fleck：嵌入式 WebSocket 服务器（MIT），用于局域网直连，不依赖 ASP.NET Core 运行时 -->
    <PackageReference Include="Fleck" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/RemoteCI.Shared/RemoteCI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
