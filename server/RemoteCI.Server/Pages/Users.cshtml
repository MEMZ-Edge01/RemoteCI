@page
@model UsersModel
@{ ViewData["Title"] = "人员权限"; }
<div class="page-head"><div><p class="eyebrow">账号与权限</p><h1>人员管理</h1></div></div>
<section class="panel"><h2>新建账号</h2><form method="post" asp-page-handler="Create" class="form-grid"><label>ID<input asp-for="Create.Username" /></label><label>用户名<input asp-for="Create.DisplayName" /></label><label>初始密码<input asp-for="Create.Password" type="password" /></label><label>角色<select asp-for="Create.Role" asp-items="Html.GetEnumSelectList<UserRole>()"></select></label><fieldset class="permissions"><legend>普通用户附加权限</legend><label><input asp-for="Create.AccessWebUi" /> WebUI</label><label><input asp-for="Create.ManageUsers" /> 人员管理</label><label><input asp-for="Create.SendNotifications" /> 发送与清除通知</label><label><input asp-for="Create.ManageSchedule" /> 换课</label><label><input asp-for="Create.SystemControl" /> 主界面与电源控制</label></fieldset><button type="submit">创建账号</button></form></section>
<section class="panel"><h2>现有账号</h2><div class="user-list">@foreach (var user in Model.Accounts) { <article class="user-card"><form method="post" asp-page-handler="Update" class="form-grid"><input type="hidden" name="Edit.Id" value="@user.Id" /><div><strong>@user.DisplayName</strong><small>ID：@user.Username · 更新于 @user.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div><label>用户名<input name="Edit.DisplayName" value="@user.DisplayName" /></label><label>角色<select name="Edit.Role"><option value="1" selected="@(user.Role == UserRole.User)">普通用户</option><option value="2" selected="@(user.Role == UserRole.Admin)">管理员</option></select></label><label class="check"><input type="checkbox" name="Edit.Enabled" value="true" checked="@user.Enabled" /> 启用</label><fieldset class="permissions"><legend>附加权限</legend><label><input type="checkbox" name="Edit.AccessWebUi" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.AccessWebUi)" /> WebUI</label><label><input type="checkbox" name="Edit.ManageUsers" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageUsers)" /> 人员</label><label><input type="checkbox" name="Edit.SendNotifications" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SendNotifications)" /> 通知</label><label><input type="checkbox" name="Edit.ManageSchedule" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.ManageSchedule)" /> 换课</label><label><input type="checkbox" name="Edit.SystemControl" value="true" checked="@user.GrantedPermissions.HasFlag(UserPermissions.SystemControl)" /> 系统控制</label></fieldset><button type="submit">保存</button></form><div class="row-actions"><form method="post" asp-page-handler="ResetPassword"><input type="hidden" name="id" value="@user.Id" /><input name="password" type="password" minlength="8" maxlength="128" placeholder="新密码" required /><button class="ghost" type="submit">重置密码</button></form><form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除此账号？')"><input type="hidden" name="id" value="@user.Id" /><button class="danger ghost" type="submit">删除</button></form></div></article> }</div></section>
