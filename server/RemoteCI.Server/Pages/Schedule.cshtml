@page
@model ScheduleModel
@{ ViewData["Title"] = "七日课表"; }
<div class="page-head"><div><p class="eyebrow">指定日期临时课表</p><h1>未来七日换课</h1></div><span class="status @(Model.PluginOnline ? "online" : "offline")">@(Model.PluginOnline ? "可执行" : "插件离线")</span></div>
@if (Model.Bundle is null)
{
    <div class="notice warning">插件尚未同步七日课表。</div>
    <form method="post" asp-page-handler="Pull" class="stack">
        <button type="submit" disabled="@(!Model.PluginOnline)">立即向插件拉取课表</button>
    </form>
}
else
{
    <div class="schedule-grid">@foreach (var day in Model.Bundle.Days) { <section class="day-card"><header><strong>@day.Date</strong><span>@(day.Enabled ? day.ClassPlanName : "无课")</span></header>@foreach (var course in day.Courses) { <div class="course"><b>@course.Label</b><span>@course.Subject</span><small>@course.StartTime–@course.EndTime</small></div> }</section> }</div>
    <section class="panel"><h2>提交修改</h2><form method="post" class="form-grid"><label>日期与原节次<select asp-for="Input.SourceSelection">@foreach (var day in Model.Bundle.Days.Where(x => x.Enabled)) { @foreach (var course in day.Courses) { <option value="@day.Date|@day.Revision|@course.Index">@day.Date · @course.Label · @course.Subject</option> } }</select></label><label>模式<select asp-for="Input.Mode" asp-items="Html.GetEnumSelectList<ScheduleChangeMode>()"></select></label><label>目标节次（交换，0 起）<input asp-for="Input.TargetIndex" type="number" min="0" /></label><label>替换科目<select asp-for="Input.ReplacementSubjectId"><option value="">不选择</option>@foreach (var subject in Model.Bundle.Subjects) { <option value="@subject.Id">@subject.Name</option> }</select></label><button type="submit" disabled="@(!Model.PluginOnline)">执行并等待真实回执</button></form></section>
}
<section class="panel">
    <h2>自动拉取课表</h2>
    <p class="muted">插件每次连接时都会自动拉取；这里可额外设置在线期间的刷新周期。</p>
    <form method="post" asp-page-handler="PullInterval" class="form-grid">
        <label>拉取间隔
            <select asp-for="PullInterval">
                <option value="0">关闭</option>
                <option value="15">每 15 分钟</option>
                <option value="60">每小时</option>
                <option value="360">每 6 小时</option>
                <option value="1440">每天</option>
            </select>
        </label>
        <button type="submit">保存间隔</button>
    </form>
</section>
