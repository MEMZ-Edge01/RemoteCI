@page
@model NotificationsModel
@{ ViewData["Title"] = "发送通知"; }
<div class="page-head"><div><p class="eyebrow">ClassIsland 与手表广播</p><h1>发送自定义通知</h1></div><span class="status @(Model.PluginOnline ? "online" : "offline")">@(Model.PluginOnline ? "插件在线" : "插件离线")</span></div>
<section class="panel narrow"><form method="post" class="stack"><label>标题<input asp-for="Input.Title" maxlength="60" placeholder="RemoteCI 通知" /></label><p class="muted">标题与正文均可留空：标题留空时显示“RemoteCI 通知”，正文留空时显示原标题。</p><p class="muted">开启“强制在标题显示发送人”后，最终标题会添加“由用户名发送：”前缀。</p><label>正文<textarea asp-for="Input.Message" maxlength="500" rows="6"></textarea></label><p class="muted">插件确认 ClassIsland 已显示后，才会向所有在线手表广播 custom 事件。</p><button type="submit" disabled="@(!Model.PluginOnline)">发送并等待回执</button></form></section>
<section class="panel narrow"><h2>发送人显示</h2><form method="post" asp-page-handler="Settings" class="stack"><label class="check"><input type="checkbox" asp-for="ForceSenderInTitle" /> 强制在标题显示发送人</label><p class="muted">关闭后，WebUI 和手表发送的通知标题不再自动显示发送人；开关会同步到在线手表。</p><button type="submit">保存设置</button></form></section>
