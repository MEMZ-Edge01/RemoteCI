@page
@model AccountModel
@{ ViewData["Title"] = "个人账号"; }
<div class="page-head"><div><p class="eyebrow">个人安全</p><h1>@Model.CurrentUser.DisplayName</h1><p class="muted">ID：@Model.CurrentUser.UserName · @Model.CurrentUser.Role</p></div></div>
<div class="two-column">
    <section class="panel"><h2>修改密码</h2><form method="post" asp-page-handler="Password" class="stack"><div asp-validation-summary="All" class="validation"></div><label>当前密码<input asp-for="Password.CurrentPassword" type="password" autocomplete="current-password" /></label><label>新密码<input asp-for="Password.NewPassword" type="password" autocomplete="new-password" /></label><button type="submit">修改并撤销设备登录</button></form></section>
    <section class="panel"><h2>已登录设备</h2>@if (Model.Sessions.Count == 0) { <p class="muted">暂无手表设备会话。</p> } else { <div class="list">@foreach (var session in Model.Sessions) { <article><div><strong>@session.DeviceName</strong><small>最近使用 @session.LastSeenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@session.Id" /><button class="danger ghost" type="submit">撤销</button></form></article> }</div> }</section>
    @if (Model.Permissions.HasFlag(UserPermissions.ManageUsers))
    {
        <section class="panel update-panel">
            <h2>系统更新@(Model.IsFnos ? "（飞牛 fnOS）" : "")</h2>
            @if (Model.IsFnos)
            {
                <p class="muted">当前服务端版本 v@(Model.CurrentVersion)。发现新版本后会自动下载 fpk 安装包，再到飞牛应用中心手动安装完成升级（应用中心会自动拉取新镜像并重建容器）。</p>
            }
            else
            {
                <p class="muted">当前服务端版本 v@(Model.CurrentVersion)，更新从 GitHub 仓库最新 release 拉取。</p>
            }
            @if (!string.IsNullOrEmpty(Model.CheckMessage))
            {
                <p class="notice @(Model.UpdateSucceeded ? "ok" : "warn")">@Model.CheckMessage</p>
            }
            @if (Model.DownloadedFpk is not null)
            {
                var fpkName = System.IO.Path.GetFileName(Model.DownloadedFpk);
                <p class="muted">已下载：@fpkName</p>
                <p><a class="button" href="@Url.Page("/Account", "DownloadFpk", new { file = fpkName })">把 fpk 保存到本机</a></p>
            }
            @if (Model.LatestRelease is not null)
            {
                var latestVersion = UpdateService.NormalizeVersion(Model.LatestRelease.Tag);
                var hasNewer = UpdateService.IsNewer(latestVersion, Model.CurrentVersion);
                <p class="muted">最新版本 v@(latestVersion)</p>
                @if (!string.IsNullOrEmpty(Model.LatestRelease.Body))
                {
                    <details class="release-notes"><summary>查看更新说明</summary><pre>@Model.LatestRelease.Body</pre></details>
                }
                @if (hasNewer && Model.ServerAsset is not null)
                {
                    <form method="post" asp-page-handler="Update" class="stack" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='处理中…'">
                        <button type="submit">@(Model.IsFnos ? "下载 v" + latestVersion + " fpk 安装包" : "下载并更新到 v" + latestVersion)</button>
                    </form>
                }
                else if (hasNewer)
                {
                    <p class="muted">@(Model.IsFnos ? "当前 release 未附带 fpk 安装包，请到 GitHub 手动下载。" : "当前平台暂无可用的更新包，请到 GitHub 手动下载。")</p>
                }
            }
            <form method="post" asp-page-handler="CheckUpdate" class="stack"><button type="submit">检查更新</button></form>
        </section>
    }
</div>
